version: '3.8'

services:
  web:
    build: .
    expose:
    - "5002"
    depends_on:
      - redis
    environment:
      - REDIS_HOST=redis
      - REDIS_PORT=6379
  
  redis:
    image: "redis:latest"
    ports:
    - "6379:6379"
    volumes:
    - redis-data:/data
  
  nginx:
    image: nginx:latest
    ports:
    - "5002:5002"
    volumes:
    - ./nginx.conf:/etc/nginx/nginx.conf
    depends_on:
      - web

# volume: this will ensure that redis data persists even if the container is stopped.
# meaning the page will continue from wherever it was before the container was stopped.

volumes:
  redis-data:

